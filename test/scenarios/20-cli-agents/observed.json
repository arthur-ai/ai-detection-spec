{
  "scenario": "20-cli-agents",
  "identifiers": [
    {
      "agent": "claude-code",
      "route": "binaries",
      "value": "~/.local/bin/claude"
    },
    {
      "agent": "claude-code",
      "route": "state_dirs",
      "value": "~/.claude"
    },
    {
      "agent": "cline",
      "route": "npm",
      "value": "cline"
    },
    {
      "agent": "codex-cli",
      "route": "npm",
      "value": "@openai/codex"
    },
    {
      "agent": "copilot-cli",
      "route": "npm",
      "value": "@github/copilot"
    },
    {
      "agent": "gemini-cli",
      "route": "npm",
      "value": "@google/gemini-cli"
    }
  ]
}
