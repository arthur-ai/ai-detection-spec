artifacts/
.DS_Store

# Claude Code local state (worktrees, session scratch). Never part of the repo.
# Skills ARE: .claude/skills/release encodes how a release is cut, and it is version
# controlled with the process it describes. The glob is `.claude/*` rather than
# `.claude/`, because git will not descend into an excluded directory to honour a
# negation inside it.
.claude/*
!.claude/skills/

# bin/classify is importable (test/test_matcher.py runs it as a subprocess, but a
# reader will import it to try image_repo()), and Python drops a __pycache__ beside it.
__pycache__/
*.pyc

# Aider writes its chat log into whatever directory it runs in, and one was committed from
# this one. This repo detects agent state; it is not a place to keep any.
.aider*
